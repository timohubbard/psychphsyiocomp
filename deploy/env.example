# /etc/myimotions/env — owned by root, mode 600, read by the systemd units.
# Copy this file there and fill it in. Never commit the real one.

# The public name participants are sent to. Caddy gets its certificate for it.
MYIMOTIONS_DOMAIN=study.example.ac.uk

# Shared by server/ingest.py and tools/serve.mjs --ingest. At least 16
# characters; generate with:  openssl rand -hex 32
INGEST_TOKEN=

# Local ports. Nothing outside the machine should reach either.
PORT=5173
INGEST_PORT=5175
