{
  "name": "open-behavioral-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source webcam-based behavioral research platform \u2014 an iMotions-equivalent built from open components. Academic / non-profit build.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test \"engines/**/*.test.mjs\" \"packages/**/*.test.mjs\" \"web/**/*.test.mjs\" \"tools/**/*.test.mjs\"",
    "licenses": "node tools/license-inventory/report.mjs",
    "licenses:json": "node tools/license-inventory/report.mjs --json",
    "licenses:commercial-gate": "node tools/license-inventory/report.mjs --fail-on-restricted",
    "check": "npm run licenses && npm run test:all && npm run verify:m0",
    "test:py": "node tools/py.mjs -m pytest",
    "test:all": "npm test && npm run test:py",
    "models": "node tools/py.mjs tools/fetch_models.py",
    "py": "node tools/py.mjs",
    "verify:m0": "node tools/py.mjs server/verify_m0.py",
    "serve": "node tools/serve.mjs",
    "app": "node tools/py.mjs server/app.py --data out",
    "process": "node tools/py.mjs server/process_bundle.py",
    "retention": "node tools/py.mjs server/retention.py sweep",
    "withdraw": "node tools/py.mjs server/retention.py withdraw",
    "retention:schedule": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/schedule_retention.ps1",
    "retention:unschedule": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/schedule_retention.ps1 -Remove",
    "ropa": "node tools/py.mjs server/ropa.py",
    "ingest": "node tools/py.mjs server/ingest.py",
    "cohort": "node tools/py.mjs server/cohort.py",
    "export": "node tools/py.mjs server/export.py",
    "verify:gaze": "node tools/py.mjs server/verify_gaze.py --data out",
    "bench:gaze": "node tools/py.mjs server/gaze_bench.py --data out",
    "smoke:capture": "node tools/smoke_capture.mjs",
    "verify:playback": "node tools/verify_playback.mjs",
    "verify:playback:control": "node tools/verify_playback.mjs --control",
    "verify:cohort-view": "node tools/verify_cohort_view.mjs",
    "verify:codebook": "node tools/verify_codebook.mjs",
    "verify:reliability": "node tools/verify_reliability.mjs",
    "verify:pts-origin": "node tools/verify_pts_origin.mjs",
    "deploy:check": "node tools/deploy_check.mjs"
  }
}
